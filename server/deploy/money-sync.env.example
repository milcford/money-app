# /etc/money-sync.env  (chmod 600, owner root)
HOST=127.0.0.1
PORT=8787
DB_PATH=/var/lib/money-sync/money.db
# bcrypt hash: echo -n 'ВАШ_ПАРОЛЬ' | node /opt/money-sync/server.js hash
# в файле systemd символ $ экранировать не нужно, но кавычки не ставить
MONEY_PASSWORD_HASH=
# откуда открывается приложение (GitHub Pages)
ALLOWED_ORIGINS=https://milcford.github.io
# 1 = доверять X-Forwarded-For от nginx/Caddy (для ограничения попыток входа)
TRUST_PROXY=1
SESSION_DAYS=180
